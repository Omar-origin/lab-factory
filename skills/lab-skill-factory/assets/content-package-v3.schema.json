{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab Factory native content package",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "const": "3.0"
    },
    "chapter": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$"
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "relative_path",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirement_coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_id",
          "blocks"
        ],
        "properties": {
          "field_id": {
            "type": "string"
          },
          "selected_node_id": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "type": {
                  "enum": [
                    "paragraph",
                    "figure",
                    "table"
                  ]
                },
                "artifact_kind": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "ref": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "ref"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "asset_id": {
                  "type": "string"
                },
                "caption_id": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  }
                }
              },
              "required": [
                "id",
                "type"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "paragraph"
                      }
                    }
                  },
                  "then": {
                    "oneOf": [
                      {
                        "required": [
                          "text"
                        ]
                      },
                      {
                        "required": [
                          "segments"
                        ]
                      }
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "figure"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "asset_id",
                      "caption_id",
                      "caption"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "table"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "columns",
                      "rows",
                      "caption_id",
                      "caption"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
